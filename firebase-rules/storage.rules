rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read uploaded work images (the public portfolio pages need this).
    // Only a signed-in user (i.e. you, logged into admin.html) can upload/delete,
    // and each file is capped at 10MB.
    match /works/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // Portfolio page banner images.
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
